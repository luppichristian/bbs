builddir(out_build)
distdir(artifacts_dist)
dist_archive_format(zip)
dist_archive_name("$PROJECT(id)-$CFG-$PLT-$VER")
cmake_args("-DCMAKE_VERBOSE_MAKEFILE=ON")
ctest_args("--output-on-failure")

# Shared custom tool discovery.
find_tool(
  id(ninja)
  exe_name(ninja)
  dir_hints("C:/tools/ninja;{home}/tools/ninja")
  version_arg("--version")
  version_regex("([0-9]+\\.[0-9]+(\\.[0-9]+)?)")
)
