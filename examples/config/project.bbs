configs(
  debug
  release
)

id(config_example)
name("Config Example")
ver(0.3.0)

# Project-scoped discovery for tools that only this repo needs.
find_tool(
  id(asset_packer)
  exe_name(asset-packer)
  dir_hints("C:/tools/asset-packer;{home}/tools/asset-packer")
  version_arg("--version")
  version_regex("([0-9]+\\.[0-9]+(\\.[0-9]+)?)")
)

targets(
  console(
    output(config_example)
    include_dirs(
      src
    )
    dist(
      archive(true)
    )
    units(
      src/main.c
      src/config_info.c
    )
  )
)
