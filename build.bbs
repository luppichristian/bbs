builddir( "build" )

platforms (
  windows.x86_64
  windows.arm64
  windows.x86
)

project (
  name( "project" )
  version( 0.1.0 )
  author( "Christian Luppi" )
)

target (
  name( "raylib" )
  type ( "static_lib" )
  git (
    repo( "https://github.com/raysan5/raylib" )
    tag( "6.0" )
  )
)

target (
  name( "bbs" )
  type( "console" )
  warnings( "max" )
  static_runtime( false )
  depends( "raylib" )
  language("gnu11")
  sources(
    "src/bbs.c"
  )
)